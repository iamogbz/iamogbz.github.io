  "author": "iamogbz",
  "dependencies": {
    "graphql-request": "6.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "@types/aws-lambda": "^8.10.119",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "babel-jest": "^29.6.3",
    "core-js": "^3.32.1",
    "eslint": "^8.47.0",
    "eslint-plugin-import": "^2.28.1",
    "express": "^4.18.2",
    "husky": "^8.0.3",
    "jest": "^29.6.3",
    "jest-environment-jsdom": "^29.6.3",
    "lint-staged": "^14.0.1",
    "serverless": "^3.34.0",
    "serverless-frontend-plugin": "^2.0.2",
    "serverless-offline": "^12.0.4",
    "string-replace-middleware": "^1.0.2",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=10.4.0",
    "npm": ">=6.1.0"
  },
  "jest": {
    "testEnvironment": "jsdom"
  },
  "license": "GPL-3.0",
  "lint-staged": {
    "*.js": [
      "pnpm lint",
      "pnpm test -- --bail --findRelatedTests"
    ]
  },
  "repository": "git@github.com:iamogbz/iamogbz.github.io.git",
  "scripts": {
    "deploy": "env $(cat .env | xargs) serverless deploy",
    "lint": "eslint --ignore-path=.gitignore --ext .js,.ts,.jsx,.tsx --fix .",
    "precommit": "lint-staged",
    "prepare": "husky install",
    "start": "env $(cat .env | xargs) serverless offline start",
    "test": "jest",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  }
